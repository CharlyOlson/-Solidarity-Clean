{
  "name": "solidarity-platform",
  "version": "2.41.0",
  "description": "Solidarity Platform implementing the Henry 7 Step 14 Trott Waltz numerological system - Professional Bridging Anchor Processing & Financial Commerce Platform",
  "main": "launcher.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "nodemon src/api/server.js --watch src",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:api": "jest --testPathPattern=tests/api",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "compile": "npx hardhat compile",
    "test:contracts": "npx hardhat test",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "deploy": "node scripts/deploy.js",
    "deploy:token": "node scripts/deploy_solidarity_token.js",
    "lint": "eslint src/ --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,md}\"",
    "clean": "rimraf node_modules/ frontend/node_modules/ frontend/build/ coverage/ logs/ cache/ artifacts/",
    "reset": "npm run clean && npm install",
    "license:generate": "node scripts/generate-license-key.js",
    "frontend:install": "cd frontend && npm install",
    "frontend:dev": "cd frontend && npm start",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm test",
    "security:test": "node security/security-tests.js"
  },
  "keywords": [
    "bridging-anchor-processing",
    "signal-processing",
    "financial-commerce",
    "blockchain",
    "spatial-processing",
    "professional-studio",
    "base-ratio-analysis",
    "real-time-processing",
    "secure-transactions",
    "api-server",
    "frontend-ready",
    "solidarity",
    "numerology",
    "sacred-geometry",
    "henry-7-step-14-trott-waltz",
    "cubit-calculation",
    "bridging-progression"
  ],
  "authors": [
    "Scott Charles Olson (Charly)",
    "Charles H. Dykes (Hank)"
  ],
  "author": {
    "name": "Scott Charles Olson",
    "email": "contact@solidarity.com",
    "url": "https://solidarity.com"
  },
  "contributors": [
    {
      "name": "Charles H. Dykes",
      "role": "Framework Concept Designer"
    }
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlyOlson/Solidarity.git"
  },
  "bugs": {
    "url": "https://github.com/CharlyOlson/Solidarity/issues"
  },
  "homepage": "https://github.com/CharlyOlson/Solidarity#readme",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0",
    "python": ">=3.8.0"
  },
  "dependencies": {
    "artillery": "^2.0.4",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.15.0",
    "helmet": "^6.1.5",
    "joi": "^17.9.1",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.2",
    "pg": "^8.10.0",
    "redis": "^4.6.5",
    "sequelize": "^6.31.0",
    "sharp": "^0.32.0",
    "socket.io": "^4.6.1",
    "stripe": "^22.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.8.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.39.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^1.7.1",
    "hardhat": "^2.19.0",
    "jest": "^29.7.0",
    "lint-staged": "^16.3.3",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/api/server.js",
      "!src/config/**",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleNameMapper": {
      "^.*/ai_integration/ollama_integration$": "<rootDir>/tests/__mocks__/ollama_integration.js",
      "^.*/ai/OllamaProvider$": "<rootDir>/tests/__mocks__/ollama_integration.js"
    },
    "testTimeout": 10000
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run test"
    }
  },
  "config": {
    "port": 3000,
    "logLevel": "info",
    "apiVersion": "v1"
  },
  "funding": {
    "type": "individual",
    "url": "https://solidarity.com/funding"
  },
  "publishConfig": {
    "registry": "https://npm.solidarity.com"
  }
}
