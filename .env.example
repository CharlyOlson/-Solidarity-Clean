# Solidarity Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ===========================================
# FINANCIAL SAFETY SETTINGS
# ===========================================
# FINANCIAL_TEST_MODE controls whether live (non-demo) financial operations
# are permitted.  Defaults to true (demo/test-only) when not set.
# Set to false ONLY after completing docs/PRODUCTION_CHECKLIST.md.
FINANCIAL_TEST_MODE=true

# RSA signing secret for wallet keys — REQUIRED in production.
# A dev-only default is used automatically when NODE_ENV != production.
# FINANCIAL_KEY_SECRET=change-me-in-production

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
PORT=3000
TIER=personal

# ===========================================
# SECURITY SETTINGS
# ===========================================
JWT_SECRET=your_jwt_secret

# ===========================================
# BLOCKCHAIN / HARDHAT SETTINGS
# ===========================================
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
PRIVATE_KEY=your_deployer_private_key

# ===========================================
# AI INTEGRATION SETTINGS
# ===========================================
# Ollama (Local AI - free, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Perplexity (optional - for business tier)
PERPLEXITY_API_KEY=optional_for_business_tier

# ===========================================
# STRIPE SETTINGS (business tier only)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_subscription_price_id
